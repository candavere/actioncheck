{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "actioncheck",
          "version": "0.1.0",
          "rules": [
            {
              "id": "AC000",
              "name": "yaml-syntax",
              "shortDescription": {
                "text": "The file is not valid YAML."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AC002",
              "name": "run-needs-shell",
              "shortDescription": {
                "text": "In a composite action every `run` step must set `shell`."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AC003",
              "name": "inputs",
              "shortDescription": {
                "text": "`inputs.<name>` must be declared under `inputs:`; declared inputs that are never used are reported as warnings."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AC004",
              "name": "step-ids",
              "shortDescription": {
                "text": "`steps.<id>` must refer to a step defined earlier; step ids must be unique; output values must point at existing steps."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AC006",
              "name": "expressions",
              "shortDescription": {
                "text": "Expressions must parse, call known functions and use contexts that exist in composite actions (no `secrets`, `needs` or `vars`)."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AC007",
              "name": "uses-ref",
              "shortDescription": {
                "text": "`uses:` must be `owner/repo[/path]@ref`, `./local`, or `docker://image`; refs not pinned to a full commit SHA are warnings."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "AC003",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "input \"who\" is declared but never used in this action"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/actions/hello/action.yml"
                },
                "region": {
                  "startLine": 4,
                  "startColumn": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "AC002",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "\"run\" step has no \"shell\"; composite actions require one (for example \"shell: bash\")"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/actions/hello/action.yml"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 7
                }
              }
            }
          ]
        },
        {
          "ruleId": "AC003",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "input \"whom\" is not declared in this action's inputs (declared: who)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/actions/hello/action.yml"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 28
                }
              }
            }
          ]
        },
        {
          "ruleId": "AC007",
          "ruleIndex": 5,
          "level": "error",
          "message": {
            "text": "\"uses: actions/checkout\" has no ref; add \"@<commit-sha>\" (or a tag)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/actions/hello/action.yml"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 13
                }
              }
            }
          ]
        },
        {
          "ruleId": "AC006",
          "ruleIndex": 4,
          "level": "error",
          "message": {
            "text": "the \"secrets\" context is not available in composite actions; pass the secret in as an input"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/actions/hello/action.yml"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 22
                }
              }
            }
          ]
        },
        {
          "ruleId": "AC004",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "step id \"build\" is not defined in this action"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/actions/hello/action.yml"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 50
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
